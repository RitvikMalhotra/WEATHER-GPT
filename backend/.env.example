# WeatherGPT backend — example configuration.
#
# Copy to `.env` for local development:  cp .env.example .env
# Every value below is a development default and is safe to commit.
# Real credentials belong in the environment or a secret manager, never here.

# --- Identity ---------------------------------------------------------------
APP_NAME="WeatherGPT API"
APP_VERSION=1.0.0
SERVICE_NAME=weathergpt-backend

# --- Runtime ----------------------------------------------------------------
# One of: development | staging | production
ENVIRONMENT=development
DEBUG=true

# --- HTTP -------------------------------------------------------------------
API_V1_PREFIX=/api/v1

# --- Conversational AI ------------------------------------------------------
# The AI layer calls the validated WeatherGPT API only; it has no weather
# provider credentials. The default uses deterministic intent routing and
# grounded rendering, with no model process required.
# This must name the host and port the API process is actually listening on:
# the AI layer reaches its own service over HTTP. Serving on another port
# without changing this makes every conversational answer come back
# "temporarily unavailable" while the REST endpoints keep working.
AI_BACKEND_BASE_URL=http://127.0.0.1:8000
AI_BACKEND_TIMEOUT_SECONDS=10
# One of: disabled | groq | openai_compatible
# `groq` uses the hosted endpoint below; `openai_compatible` targets a local
# Ollama/vLLM/llama.cpp server. Either way the model only selects a tool.
AI_LLM_PROVIDER=disabled
AI_LLM_BASE_URL=http://127.0.0.1:11434/v1
AI_LLM_MODEL=llama3.2:3b
# AI_LLM_API_KEY=
AI_LLM_TIMEOUT_SECONDS=20

# Groq. Read only when AI_LLM_PROVIDER=groq. Put the real key in .env, which is
# gitignored — never in this template.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=

# --- Observability ----------------------------------------------------------
# One of: CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# console = human readable (local); json = one structured object per line
LOG_FORMAT=console

# --- Meteorological providers -----------------------------------------------
# Source that leads the fallback chain. See GET /api/v1/providers for the ids
# registered in a running deployment.
DEFAULT_PROVIDER=open-meteo
# Per-request deadline for an upstream call, in seconds.
PROVIDER_TIMEOUT_SECONDS=8.0
# Extra attempts after the first, for transient upstream failures.
PROVIDER_MAX_RETRIES=2
# Identifies this service to upstream APIs, as their fair-use policies expect.
HTTP_USER_AGENT="WeatherGPT/1.0 (+https://github.com/weathergpt)"

# Open-Meteo needs no API key. Sources that do (IMD, commercial models) will
# read their credentials from the environment, never from source control.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# --- NOAA GFS (numerical weather prediction) --------------------------------
# Registered alongside Open-Meteo rather than replacing it: the blend stays the
# default and GFS is selected by name with ?provider=noaa-gfs. This endpoint
# returns the numerical model alone, so a response is attributable to a run.
GFS_ENABLED=true
GFS_FORECAST_URL=https://api.open-meteo.com/v1/gfs
GFS_RUN_METADATA_URL=https://api.open-meteo.com/data/ncep_gfs013/static/meta.json

# --- OpenStreetMap / Nominatim (location resolution only, never weather) -----
# The default gazetteer when GEOAPIFY_API_KEY is unset: it needs no key, indexes
# localities a population-thresholded gazetteer omits, and carries Hindi place
# names. Nominatim asks for one request per second and an honest User-Agent.
NOMINATIM_ENABLED=true
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_MIN_INTERVAL_SECONDS=1.0

# --- Geoapify (location resolution only, never weather) ----------------------
# Open-Meteo's gazetteer only lists populated places above a population
# threshold, so an Indian locality such as Miyapur in Hyderabad is missing from
# it and a same-named village elsewhere wins the query. Geoapify indexes
# localities and suburbs, which is what makes "which Miyapur did you mean?" a
# real choice instead of a wrong guess.
# Free key: https://myprojects.geoapify.com/  (put the real key in .env)
# Leave unset and Open-Meteo answers every location query exactly as before.
GEOAPIFY_GEOCODE_URL=https://api.geoapify.com/v1/geocode/search
# GEOAPIFY_API_KEY=

# --- India Meteorological Department (official Indian source) ----------------
# IMD requires an API key AND server IP whitelisting. Request access via
# https://api.imd.gov.in/public/index.php  (registration/login) and the
# IP-whitelisting form linked from https://mausam.imd.gov.in/responsive/apis.php
# Without IMD_API_KEY the provider is not registered and Open-Meteo/GFS serve
# every request exactly as before.
IMD_ENABLED=true
IMD_BASE_URL=https://api.imd.gov.in/api/v1
# IMD_API_KEY=
# How the key is sent. Confirm against the API document issued on approval;
# set IMD_API_KEY_PARAM instead to send it as a query parameter.
IMD_API_KEY_HEADER=x-api-key
# IMD_API_KEY_PARAM=
IMD_MAX_STATION_DISTANCE_KM=50.0
IMD_STATION_CACHE_HOURS=12

# --- Response caching --------------------------------------------------------
# Seconds to retain a response. Set to 0 to disable a cache entirely.
CURRENT_CACHE_TTL_SECONDS=300
FORECAST_CACHE_TTL_SECONDS=900
# Places do not move; geocoding results are held for a day.
GEOCODING_CACHE_TTL_SECONDS=86400

# --- Forecast and validation limits ------------------------------------------
MAX_FORECAST_DAYS=16
DEFAULT_FORECAST_DAYS=7
# An observation older than this is flagged stale by the validation engine.
MAX_OBSERVATION_AGE_MINUTES=180
# How far ahead of us an observation may be dated before it is rejected.
MAX_CLOCK_SKEW_MINUTES=90

# --- Persistence -------------------------------------------------------------
# PostgreSQL with PostGIS. Must name an async driver (+asyncpg).
# Start the database with:  docker compose up -d --wait postgres
# Then apply migrations:    cd backend && alembic upgrade head
#
# These are local development credentials that match docker-compose.yml.
# Real deployments inject this from the environment or a secret manager.
# Leave DATABASE_URL unset to run without persistence: current conditions and
# forecasts still work, and /api/v1/weather/historical returns 503.
DATABASE_URL=postgresql+asyncpg://weathergpt:weathergpt@localhost:5432/weathergpt

# Set false to run against a configured database with writes switched off.
PERSISTENCE_ENABLED=true
# Log every statement. Noisy; for debugging only.
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10.0
# Window used to group forecast points into one generation, in minutes.
# Repeated requests inside a window update rows; a new window appends a
# generation, which is what preserves forecast-skill history.
FORECAST_GENERATION_BUCKET_MINUTES=60

# --- Historical queries -------------------------------------------------------
HISTORY_DEFAULT_RADIUS_KM=25.0
HISTORY_MAX_RADIUS_KM=500.0
HISTORY_MAX_RANGE_DAYS=366
HISTORY_MAX_RESULTS=1000

# --- Alert engine and watched locations ---------------------------------------
# Every threshold in app/alerts/rules.py is an ENGINEERING DEFAULT for a
# prototype, not an official safety threshold, and each is overridable here (see
# app/config/settings.py for the full list). A deployment used for real
# decisions must set its own values from a sourced specification.
#
# The alert engine and the watched-location panel both require a reachable
# DATABASE_URL: without one, no rule is evaluated and no alert is stored.
ALERT_EVALUATION_ENABLED=true
ALERT_OBSERVATION_VALIDITY_MINUTES=60
ALERT_FORECAST_LOOKAHEAD_HOURS=48
# The in-process loop that re-evaluates watched locations. Off disables
# automatic evaluation only; the HTTP refresh endpoint keeps working.
ALERT_MONITOR_ENABLED=true
ALERT_MONITOR_INTERVAL_SECONDS=900
ALERT_MONITOR_BATCH_SIZE=50

# --- Docker Compose overrides -------------------------------------------------
# Consumed by docker-compose.yml, not by the application.
POSTGRES_USER=weathergpt
POSTGRES_PASSWORD=weathergpt
POSTGRES_DB=weathergpt
POSTGRES_PORT=5432

# --- Later phases -----------------------------------------------------------
# Redis and other future integration credentials are introduced by the phases
# below this line is read by the current code.

# WeatherGPT backend — example configuration.
#
# Copy to `.env` for local development:  cp .env.example .env
# Every value below is a development default and is safe to commit.
# Real credentials belong in the environment or a secret manager, never here.

# --- Identity ---------------------------------------------------------------
APP_NAME="WeatherGPT API"
APP_VERSION=1.0.0
SERVICE_NAME=weathergpt-backend

# --- Runtime ----------------------------------------------------------------
# One of: development | staging | production
ENVIRONMENT=development
DEBUG=true

# --- HTTP -------------------------------------------------------------------
API_V1_PREFIX=/api/v1

# --- Observability ----------------------------------------------------------
# One of: CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# console = human readable (local); json = one structured object per line
LOG_FORMAT=console

# --- Meteorological providers -----------------------------------------------
# Source that leads the fallback chain. See GET /api/v1/providers for the ids
# registered in a running deployment.
DEFAULT_PROVIDER=open-meteo
# Per-request deadline for an upstream call, in seconds.
PROVIDER_TIMEOUT_SECONDS=8.0
# Extra attempts after the first, for transient upstream failures.
PROVIDER_MAX_RETRIES=2
# Identifies this service to upstream APIs, as their fair-use policies expect.
HTTP_USER_AGENT="WeatherGPT/1.0 (+https://github.com/weathergpt)"

# Open-Meteo needs no API key. Sources that do (IMD, commercial models) will
# read their credentials from the environment, never from source control.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# --- Response caching --------------------------------------------------------
# Seconds to retain a response. Set to 0 to disable a cache entirely.
CURRENT_CACHE_TTL_SECONDS=300
FORECAST_CACHE_TTL_SECONDS=900
# Places do not move; geocoding results are held for a day.
GEOCODING_CACHE_TTL_SECONDS=86400

# --- Forecast and validation limits ------------------------------------------
MAX_FORECAST_DAYS=16
DEFAULT_FORECAST_DAYS=7
# An observation older than this is flagged stale by the validation engine.
MAX_OBSERVATION_AGE_MINUTES=180
# How far ahead of us an observation may be dated before it is rejected.
MAX_CLOCK_SKEW_MINUTES=90

# --- Persistence -------------------------------------------------------------
# PostgreSQL with PostGIS. Must name an async driver (+asyncpg).
# Start the database with:  docker compose up -d --wait postgres
# Then apply migrations:    cd backend && alembic upgrade head
#
# These are local development credentials that match docker-compose.yml.
# Real deployments inject this from the environment or a secret manager.
# Leave DATABASE_URL unset to run without persistence: current conditions and
# forecasts still work, and /api/v1/weather/historical returns 503.
DATABASE_URL=postgresql+asyncpg://weathergpt:weathergpt@localhost:5432/weathergpt

# Set false to run against a configured database with writes switched off.
PERSISTENCE_ENABLED=true
# Log every statement. Noisy; for debugging only.
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10.0
# Window used to group forecast points into one generation, in minutes.
# Repeated requests inside a window update rows; a new window appends a
# generation, which is what preserves forecast-skill history.
FORECAST_GENERATION_BUCKET_MINUTES=60

# --- Historical queries -------------------------------------------------------
HISTORY_DEFAULT_RADIUS_KM=25.0
HISTORY_MAX_RADIUS_KM=500.0
HISTORY_MAX_RANGE_DAYS=366
HISTORY_MAX_RESULTS=1000

# --- Docker Compose overrides -------------------------------------------------
# Consumed by docker-compose.yml, not by the application.
POSTGRES_USER=weathergpt
POSTGRES_PASSWORD=weathergpt
POSTGRES_DB=weathergpt
POSTGRES_PORT=5432

# --- Later phases -----------------------------------------------------------
# Redis and AI credentials are introduced by the phases that use them. Nothing
# below this line is read by the current code.

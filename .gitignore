# --- Secrets ----------------------------------------------------------------
# .env holds real credentials; .env.example is the committed template.
.env
.env.*
!.env.example

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Tooling caches ----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Editors and OS ----------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Logs and local artefacts ------------------------------------------------
*.log

# Note: alembic/versions/ is source and IS tracked. Only the caches and
# secrets above are ignored.
